{# The properties, in the core's register idiom: a name over its kind and
   where it is, one fact a column, an Open door. Added by the tiers, as a draft. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Shell/_icons.html.twig' as icons %}
{% import '@Identity/positions/_macros.html.twig' as positions %}
{% import '@VivutioProperty/properties/_macros.html.twig' as properties_ %}

{% block title %}Properties{% endblock %}
{% block here %}properties{% endblock %}

{% block page %}
<header class="page-head"><div><nav class="trail" aria-label="Where you are">Properties</nav><div class="title"><h1>Properties</h1><span class="about">The camps, lodges and hotels the organization runs</span></div></div></header>

<div class="stack">
    {% if door('properties.configure') %}
    <form class="panel" method="post" action="{{ path('property_add') }}" novalidate>
        <header class="panel-head"><h2>Add a property</h2><p>What it is and where; the rest is set on its configure page</p></header>
        <input type="hidden" name="_token" value="{{ csrf_token('property_add') }}">
        {% if expired %}<div class="notice danger" role="alert">{{ icons.icon('alert') }}<span>The form had expired, so nothing was saved. Add it again.</span></div>{% endif %}
        <div class="grid-3">
            <div class="field{{ wrong.name is defined ? ' wrong' }}"><label for="property-name">Name</label><input class="input" id="property-name" name="name" value="{{ typed.name ?? '' }}" required maxlength="120">{% if wrong.name is defined %}<div class="hint"><span>{{ wrong.name }}</span></div>{% endif %}</div>
            <div class="field{{ wrong.type is defined ? ' wrong' }}"><label for="property-type">Type</label>
                <select class="select" id="property-type" name="type">{% for type in types %}<option value="{{ type.value }}"{{ type.value == (typed.type ?? 'lodge') ? ' selected' }}>{{ type.label }}</option>{% endfor %}</select>
                {% if wrong.type is defined %}<div class="hint"><span>{{ wrong.type }}</span></div>{% endif %}</div>
            <div class="field{{ wrong.location is defined ? ' wrong' }}"><label for="property-location">Where it is</label><input class="input" id="property-location" name="location" value="{{ typed.location ?? '' }}" required maxlength="160"><div class="hint"><span>{{ wrong.location ?? 'In a guest\'s words: Central Serengeti, Tanzania' }}</span></div></div>
        </div>
        <footer class="panel-foot"><span class="state">It is added as a draft</span><button type="submit" class="button main">Add the property</button></footer>
    </form>
    {% endif %}

    {%- set query = register.query -%}
    {%- set type_chosen = types|filter(t => t.value == (query.type ?? ''))|first -%}
    <form class="tools" method="get" action="{{ path('property_list') }}" data-tools>
        <label class="find">{{ icons.icon('search', 16) }}<input type="search" name="q" value="{{ query.q ?? '' }}" placeholder="Name or place" aria-label="Search the properties"></label>
        {% if query.status is defined %}<input type="hidden" name="status" value="{{ query.status }}">{% endif %}
        {% if query.type is defined %}<input type="hidden" name="type" value="{{ query.type }}">{% endif %}
        <span data-facet="status">
            <a class="chip" data-chip href="{{ path('property_list', query|filter((v, k) => k != 'status')) }}"{{ query.status is not defined ? ' aria-current="true"' }}>All <em>{{ register.total }}</em></a>
            {% for status in statuses %}
                <a class="chip" data-chip href="{{ path('property_list', query|filter((v, k) => k != 'status')|merge({status: status.value})) }}"{{ (query.status ?? '') == status.value ? ' aria-current="true"' }}>{{ status.label }} <em>{{ register.statusCounts[status.value] }}</em></a>
            {% endfor %}
        </span>
        <details class="pick" data-facet="type">
            <summary{{ type_chosen ? ' class="on"' }}>{{ type_chosen ? type_chosen.label : 'Any type' }} {{ icons.icon('down', 14) }}</summary>
            <div class="pick-menu">
                <h3>Type</h3>
                <a data-chip href="{{ path('property_list', query|filter((v, k) => k != 'type')) }}"{{ not type_chosen ? ' aria-current="true"' }}><i></i>Any<em>{{ register.total }}</em></a>
                <hr>
                {% for type in types|filter(t => register.typeCounts[t.value] is defined) %}
                    <a data-chip href="{{ path('property_list', query|filter((v, k) => k != 'type')|merge({type: type.value})) }}"{{ type_chosen and type_chosen.value == type.value ? ' aria-current="true"' }}><i></i>{{ type.label }}<em>{{ register.typeCounts[type.value] }}</em></a>
                {% endfor %}
            </div>
        </details>
        <span class="shown" data-shown>showing <b>{{ properties|length }}</b> of {{ register.total }}</span>
    </form>

    <section class="panel list">
        <table class="table">
            <thead><tr><th>Property</th><th style="width:130px">Status</th><th style="width:120px">Units</th><th style="width:140px">People</th><th style="width:90px"></th></tr></thead>
            <tbody>
            {% for property in properties %}
                {%- set count = posted[property.placeId] ?? 0 -%}
                <tr data-property="{{ property.name }}">
                    <td><div class="who"><span class="initials">{{ positions.initials(property.name) }}</span><div><b>{{ property.name }}</b><small><span data-type>{{ property.type.label }}</span> &middot; <span data-where>{{ property.location }}</span></small></div></div></td>
                    <td data-status>{{ properties_.status_chip(property.status) }}</td>
                    <td data-units>{{ (units[property.placeId] ?? 0) > 0 ? units[property.placeId] ~ ' units' : 'None yet' }}</td>
                    <td data-posted>{{ count == 0 ? 'Nobody posted' : count ~ ' posted' }}</td>
                    <td><a class="button outline" href="{{ path('property_show', {uuid: property.uuid}) }}">Open</a></td>
                </tr>
            {% else %}
                {% if register.total == 0 %}
                <tr><td colspan="5"><div class="empty"><b>No properties yet</b><span>A property is a camp, a lodge or a hotel the organization runs: add the first.</span></div></td></tr>
                {% else %}
                <tr><td colspan="5"><div class="empty"><b>Nothing matches {% if query.q is defined %}“{{ query.q }}”{% else %}these filters{% endif %}</b><span><a href="{{ path('property_list') }}">Show every property</a></span></div></td></tr>
                {% endif %}
            {% endfor %}
            </tbody>
        </table>
    </section>
</div>
{% endblock %}
