{# The properties, in the core's place idiom (the offices' register): a name
   over where it is, one fact a column, an Open door. Adding one is the
   tiers' alone. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Shell/_icons.html.twig' as icons %}
{% import '@Identity/positions/_macros.html.twig' as positions %}

{% block title %}Properties{% endblock %}
{% block here %}properties{% endblock %}

{% block page %}
<header class="page-head"><div><nav class="trail" aria-label="Where you are">Properties</nav><div class="title"><h1>Properties</h1><span class="about">The camps, lodges and hotels the organization runs</span></div></div></header>

<div class="stack">
    {% if door('properties.configure') %}
    <form class="panel" method="post" action="{{ path('property_add') }}" novalidate>
        <header class="panel-head"><h2>Add a property</h2><p>Where it is, and what its guests sleep in</p></header>
        <input type="hidden" name="_token" value="{{ csrf_token('property_add') }}">
        {% if expired %}<div class="notice danger" role="alert">{{ icons.icon('alert') }}<span>The form had expired, so nothing was saved. Add it again.</span></div>{% endif %}
        {% include '@VivutioProperty/properties/_fields.html.twig' %}
        <footer class="panel-foot"><span class="state"></span><button type="submit" class="button main">Add the property</button></footer>
    </form>
    {% endif %}

    <section class="panel list">
        <table class="table">
            <thead><tr><th>Property</th><th style="width:170px">Size</th><th style="width:90px"></th></tr></thead>
            <tbody>
            {% for property in properties %}
                <tr data-property="{{ property.name }}">
                    <td><div class="who"><span class="initials">{{ positions.initials(property.name) }}</span><div><b>{{ property.name }}</b><small data-where>{{ property.location }}</small></div></div></td>
                    <td data-size>{{ property.size }}</td>
                    <td><a class="button outline" href="{{ path('property_show', {uuid: property.uuid}) }}">Open</a></td>
                </tr>
            {% else %}
                <tr><td colspan="3"><div class="empty"><b>No properties yet</b><span>A property is a camp, a lodge or a hotel the organization runs: add the first.</span></div></td></tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
</div>
{% endblock %}
