{# A property's page, in the core's place idiom (an office's page). #}
{% extends '@Shell/page.html.twig' %}
{% import '@Shell/_icons.html.twig' as icons %}
{% import '@Identity/positions/_macros.html.twig' as positions %}

{% block title %}{{ property.name }}{% endblock %}
{% block here %}properties{% endblock %}

{% block page %}
<header class="page-head">
    <span class="initials">{{ positions.initials(property.name) }}</span>
    <div><nav class="trail" aria-label="Where you are"><a href="{{ path('property_list') }}">Properties</a> / {{ property.name }}</nav><div class="title"><h1>{{ property.name }}</h1><span class="about">{{ property.location }}</span></div></div>
    <div class="actions"><a class="button outline" href="{{ path('property_list') }}">{{ icons.icon('left', 15) }} Back to properties</a>{% if door('properties.configure') %}<a class="button outline" href="{{ path('property_configure', {uuid: property.uuid}) }}">Configure</a>{% endif %}</div>
</header>

{% if saved %}<div class="notice" role="status">{{ icons.icon('check') }}<span>The property is saved.</span></div>{% endif %}

<div class="band">
    <span class="f"><span class="k">Units</span><span class="v">{{ property.units }}<em>{{ property.unit.value }}</em></span></span>
</div>

<section class="panel">
    <header class="panel-head"><h2>Property</h2></header>
    <div class="fact"><span>Where it is</span><b data-where>{{ property.location }}</b></div>
    <div class="fact"><span>Size</span><b data-size>{{ property.size }}</b></div>
</section>
{% endblock %}
