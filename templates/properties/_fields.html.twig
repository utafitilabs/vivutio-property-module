{# A property's four fields, the same on adding and on configuring. #}
<div class="grid-2">
    <div class="field{{ wrong.name is defined ? ' wrong' }}"><label for="property-name">Name</label><input class="input" id="property-name" name="name" value="{{ typed.name ?? '' }}" required maxlength="120">{% if wrong.name is defined %}<div class="hint"><span>{{ wrong.name }}</span></div>{% endif %}</div>
    <div class="field{{ wrong.location is defined ? ' wrong' }}"><label for="property-location">Where it is</label><input class="input" id="property-location" name="location" value="{{ typed.location ?? '' }}" required maxlength="160"><div class="hint"><span>{{ wrong.location ?? 'In a guest\'s words: Central Serengeti, Tanzania' }}</span></div></div>
</div>
<div class="grid-2">
    <div class="field{{ wrong.units is defined ? ' wrong' }}"><label for="property-units">Units</label><input class="input" id="property-units" name="units" type="number" min="1" value="{{ typed.units ?? '' }}" required>{% if wrong.units is defined %}<div class="hint"><span>{{ wrong.units }}</span></div>{% endif %}</div>
    <div class="field{{ wrong.unit is defined ? ' wrong' }}"><label for="property-unit">Guests sleep in</label>
        <select class="select" id="property-unit" name="unit">{% for unit in units %}<option value="{{ unit.value }}"{{ unit.value == (typed.unit ?? 'rooms') ? ' selected' }}>{{ unit.label }}</option>{% endfor %}</select>
        {% if wrong.unit is defined %}<div class="hint"><span>{{ wrong.unit }}</span></div>{% endif %}
    </div>
</div>
