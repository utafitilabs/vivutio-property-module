{# Configuring a property, card by card as the record reads: what it is and
   its status, where it is, what it says of itself, its house rules, and how
   it is reached. Each card saves its own fields. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Shell/_icons.html.twig' as icons %}
{% import '@Identity/positions/_macros.html.twig' as positions %}
{% import '@VivutioProperty/properties/_macros.html.twig' as properties_ %}

{% block title %}Configure {{ property.name }}{% endblock %}
{% block here %}properties{% endblock %}

{% macro card(name, title, about, property) -%}
    <form class="panel" method="post" action="{{ path('property_configure', {uuid: property.uuid}) }}" data-card="{{ name }}" novalidate>
        <header class="panel-head"><h2>{{ title }}</h2><p>{{ about }}</p></header>
        <input type="hidden" name="_token" value="{{ csrf_token('property_configure') }}">
        <input type="hidden" name="card" value="{{ name }}">
{%- endmacro %}

{% macro foot(button) -%}
        <footer class="panel-foot"><span class="state">No changes</span><button type="reset" class="button quiet">Discard</button><button type="submit" class="button main">{{ button }}</button></footer>
    </form>
{%- endmacro %}

{% block page %}
{%- import _self as cards -%}
<header class="page-head">
    <span class="initials">{{ positions.initials(property.name) }}</span>
    <div><nav class="trail" aria-label="Where you are"><a href="{{ path('property_list') }}">Properties</a> / <a href="{{ path('property_show', {uuid: property.uuid}) }}">{{ property.name }}</a> / Configure</nav><div class="title"><h1>{{ property.name }}</h1></div></div>
    <div class="actions"><a class="button outline" href="{{ path('property_show', {uuid: property.uuid}) }}">{{ icons.icon('record', 15) }} View property</a></div>
</header>

{% if saved %}<div class="notice" role="status">{{ icons.icon('check') }}<span>{{ saved }} is saved.</span></div>{% endif %}
{% if expired %}<div class="notice danger" role="alert">{{ icons.icon('alert') }}<span>The form had expired, so nothing was saved. Save again.</span></div>{% endif %}

<div class="stack">
    {{ cards.card('property', 'Property', 'What it is, and whether it takes bookings', property) }}
        <div class="grid-2">
            <div class="field{{ wrong.name is defined ? ' wrong' }}"><label for="property-name">Name</label><input class="input" id="property-name" name="name" value="{{ typed.name }}" required maxlength="120">{{ properties_.hint('name', wrong, null) }}</div>
            <div class="field{{ wrong.type is defined ? ' wrong' }}"><label for="property-type">Type</label><select class="select" id="property-type" name="type">{% for type in types %}<option value="{{ type.value }}"{{ type.value == typed.type ? ' selected' }}>{{ type.label }}</option>{% endfor %}</select>{{ properties_.hint('type', wrong, null) }}</div>
        </div>
        <div class="grid-2">
            <div class="field{{ wrong.grading is defined ? ' wrong' }}"><label for="property-grading">Star grading</label><select class="select" id="property-grading" name="grading"><option value="">Not graded</option>{% for stars in 1..5 %}<option value="{{ stars }}"{{ (stars ~ '') == typed.grading ? ' selected' }}>{{ stars }} {{ stars == 1 ? 'star' : 'stars' }}</option>{% endfor %}</select>{{ properties_.hint('grading', wrong, null) }}</div>
            <div class="field{{ wrong.status is defined ? ' wrong' }}"><label for="property-status">Status</label><select class="select" id="property-status" name="status">{% for status in statuses %}<option value="{{ status.value }}"{{ status.value == typed.status ? ' selected' }}>{{ status.label }} &middot; {{ status.says }}</option>{% endfor %}</select>{{ properties_.hint('status', wrong, 'A season\'s closure is set on the calendar, not here') }}</div>
        </div>
    {{ cards.foot('Save property') }}

    {{ cards.card('where', 'Where it is', 'In a guest\'s words, and on a map', property) }}
        <div class="grid-3">
            <div class="field{{ wrong.location is defined ? ' wrong' }}"><label for="property-location">In words</label><input class="input" id="property-location" name="location" value="{{ typed.location }}" required maxlength="160">{{ properties_.hint('location', wrong, 'Central Serengeti, Tanzania') }}</div>
            <div class="field{{ wrong.latitude is defined ? ' wrong' }}"><label for="property-latitude">Latitude</label><input class="input" id="property-latitude" name="latitude" value="{{ typed.latitude }}" inputmode="decimal">{{ properties_.hint('latitude', wrong, 'Degrees, south below zero') }}</div>
            <div class="field{{ wrong.longitude is defined ? ' wrong' }}"><label for="property-longitude">Longitude</label><input class="input" id="property-longitude" name="longitude" value="{{ typed.longitude }}" inputmode="decimal">{{ properties_.hint('longitude', wrong, 'Degrees, east above zero') }}</div>
        </div>
    {{ cards.foot('Save where it is') }}

    {{ cards.card('about', 'About', 'What operators and guests read first', property) }}
        <div class="field{{ wrong.summary is defined ? ' wrong' }}"><label for="property-summary">Summary</label><input class="input" id="property-summary" name="summary" value="{{ typed.summary }}" maxlength="200">{{ properties_.hint('summary', wrong, 'One line') }}</div>
        <div class="field{{ wrong.description is defined ? ' wrong' }}"><label for="property-description">Description</label><textarea class="textarea" id="property-description" name="description" rows="5">{{ typed.description }}</textarea>{{ properties_.hint('description', wrong, null) }}</div>
    {{ cards.foot('Save about') }}

    {{ cards.card('house_rules', 'House rules', 'When guests arrive and leave, and who counts as a child', property) }}
        <div class="grid-2">
            <div class="field{{ wrong.check_in is defined ? ' wrong' }}"><label for="property-check-in">Check-in from</label><input class="input" id="property-check-in" name="check_in" type="time" value="{{ typed.check_in }}">{{ properties_.hint('check_in', wrong, 'On the 24-hour clock') }}</div>
            <div class="field{{ wrong.check_out is defined ? ' wrong' }}"><label for="property-check-out">Check-out by</label><input class="input" id="property-check-out" name="check_out" type="time" value="{{ typed.check_out }}">{{ properties_.hint('check_out', wrong, 'On the 24-hour clock') }}</div>
        </div>
        <div class="grid-2">
            <div class="field{{ wrong.infants_up_to is defined ? ' wrong' }}"><label for="property-infants-up-to">Infants up to</label><input class="input" id="property-infants-up-to" name="infants_up_to" type="number" min="0" max="17" value="{{ typed.infants_up_to }}">{{ properties_.hint('infants_up_to', wrong, 'Years of age; both ages or neither') }}</div>
            <div class="field{{ wrong.children_up_to is defined ? ' wrong' }}"><label for="property-children-up-to">Children up to</label><input class="input" id="property-children-up-to" name="children_up_to" type="number" min="1" max="17" value="{{ typed.children_up_to }}">{{ properties_.hint('children_up_to', wrong, 'Years of age; older guests are adults') }}</div>
        </div>
    {{ cards.foot('Save house rules') }}

    {{ cards.card('contact', 'Contact', 'How a guest or a partner reaches the property itself', property) }}
        <div class="grid-3">
            <div class="field{{ wrong.email is defined ? ' wrong' }}"><label for="property-email">Email</label><input class="input" id="property-email" name="email" type="email" value="{{ typed.email }}">{{ properties_.hint('email', wrong, null) }}</div>
            <div class="field{{ wrong.phone is defined ? ' wrong' }}"><label for="property-phone">Phone</label><input class="input" id="property-phone" name="phone" type="tel" value="{{ typed.phone }}">{{ properties_.hint('phone', wrong, null) }}</div>
            <div class="field{{ wrong.website is defined ? ' wrong' }}"><label for="property-website">Website</label><input class="input" id="property-website" name="website" type="url" value="{{ typed.website }}">{{ properties_.hint('website', wrong, null) }}</div>
        </div>
    {{ cards.foot('Save contact') }}
{% if is_granted('identity.delete', property) %}
<section class="panel" data-danger>
    <header class="panel-head"><h2>Danger</h2><p>Super Admins alone</p></header>
    <div class="action"><div><b>Delete</b><span>The property and everything under it: room types, seasons, rates, closures and bookings. Counted before anything goes</span></div><a class="button small danger" href="{{ path('property_delete', {uuid: property.uuid}) }}">Delete…</a></div>
</section>
{% endif %}
</div>
{% endblock %}
